@model IEnumerable<LvtNetCoreMVCLab03.Models.LvtBook>
@{
    ViewData["title"] = "Index";
}
<h2> Danh sách các quyển sách</h2><from action="" method="POST" class="form-inline" role="form">
<div class="form-group">
    <select name="PmqAuthorID" class="form-control" asp-items="@ViewBag.authors">
        <option value="">Lựa chọn tác giả</option>
    </select>
    <select name="PmqGenreId" class="form-control" asp-items="@ViewBag.genres">
        <option value="">Lựa chọn thể loại</option>
    </select>
</div>
<button type="submit" class="btn btn-primary">Tìm kiếm</button>
<a asp-action="Create" class="btn btn-danger">Thêm Mới</a>
</from>
<hr />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu Đề</th>
            <th>Tác Giả</th>
            <th>Thể Loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.LvtId</td>
                <td>@book.LvtTitle</td>
                <td>@book.LvtAuthorID</td>
                <td>@book.LvtGenreId</td>
                <td>@book.LvtPrice</td>
                <td>
                    <img src="@book.LvtImages" alt="@book.LvtTitle" width="40" />
                </td>
                <td>
                    <a asp-action="Edit" class="btn tbn-sm btn-primary">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>