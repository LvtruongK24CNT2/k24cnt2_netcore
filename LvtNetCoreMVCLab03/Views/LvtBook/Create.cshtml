@model LvtNetCoreMVCLab03.Models.LvtBook
@{
    ViewData["Title"] = "Create";
}
<h2>Thêm Mới Sách</h2>
<form action="" method="POST" enctype="mmultipart/form-data">
    <div class="form-group">
        <label asp-for="LvtTitle">Tên Sách</label>
        <input type="text" class="form-control" asp-for="LvtTitle" placeholder="Tên Sách" />
    </div>
    <div class="form-group">
        <label asp-for="LvtAuthorID">Tác Giả</label>
        <select asp-for="LvtAuthorID" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn Tác Giả</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="LvtAuthorID">Thể Loại</label>
        <select asp-for="LvtGenreId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Thể loại</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="LvtTitle">Giá Sách</label>
        <input type="text" class="form-control" asp-for="LvtPrice" placeholder="Giá Sách" />
    </div>
    <div class="form-group">
        <label asp-for="LvtTitle">Tổng số Trang</label>
        <input type="text" class="form-control" asp-for="LvtTotalPage" placeholder="Tổng số Trang" />
    </div>
    <div class="form-group">
        <label asp-for="LvtImages">Hình ảnh/Poster</label>
        <input type="file" class="form-control" asp-for="LvtImages" />
    </div>
    <div class="form-group">
        <label asp-for="LvtSumary">Giới Thiệu Ngắn</label>
        <textarea class="form-control" asp-for="LvtSumary" placeholder="Nội Dung Giới Thiệu Sách..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu lại</button>
</form>
