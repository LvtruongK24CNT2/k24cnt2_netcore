@model IEnumerable<LvtNetCoreMVCLab03.Models.LvtBook>

    <div class="row">
        @foreach (var item in Model)
    {
        <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
            <div class="thumbnail">
                <img src="@item.LvtImages" alt="" />
                <div class="caption">
                    <h3>@item.LvtTitle</h3>
                    <p>
                        Price: @item.LvtPrice
                    </p>
                </div>
            </div>
        </div> 
    }
</div>