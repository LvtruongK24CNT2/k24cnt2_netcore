@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var products = ViewData["products"] as List<lvtlesson03.Models.LvtProduct>;
}
<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in products)
                {
                    <tr>
                        <td>@item.LvtProductID</td>
                        <td>@item.LvtProductName</td>
                        <td>@item.LvtYearRelease</td>
                        <td>@item.LvtPrice</td>
                        <td>
                            <a href ="#" class="btn btn-info">Xem chi tiết</a>
                            <a href="#" class="btn btn-primary">Xóa</a>
                            <a href="#" class="btn btn-danger">Sửa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
