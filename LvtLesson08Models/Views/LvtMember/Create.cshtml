@model LvtLesson08Models.Models.DataModels.LvtMember

@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post" asp-controller="LvtMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="LvtUseName" class="control-label"></label>
                    <input asp-for="LvtUseName" class="form-control" />
                    <span asp-validation-for="LvtUseName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LvtPassword" class="control-label"></label>
                    <input asp-for="LvtPassword" class="form-control" />
                    <span asp-validation-for="LvtPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LvtFullName" class="control-label"></label>
                    <input asp-for="LvtFullName" class="form-control" />
                    <span asp-validation-for="LvtFullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LvtEmail" class="control-label"></label>
                    <input asp-for="LvtEmail" class="form-control" />
                    <span asp-validation-for="LvtEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                        <a asp-action="Index">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>