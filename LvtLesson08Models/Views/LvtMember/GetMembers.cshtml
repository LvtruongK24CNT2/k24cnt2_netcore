@{
    ViewData["Title"] = "Danh sách thành viên";
    int num = 0;
}

<div class="card">
    <h1>ViewData["Title"]</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>#No.</th>
                <th>Member Id</th>
                <th>User Name</th>
                <th>Full Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in ViewBag.Member)
            {
                num++;
                <tr>
                    <td>@num</td>
                    <td>@member.LvtMemberId</td>
                    <td>@member.LvtUserName</td>
                    <td>@member.LvtFullName</td>
                    <td>@member.LvtEmail</td>
                </tr>
            }
        </tbody>
    </table>
</div>
