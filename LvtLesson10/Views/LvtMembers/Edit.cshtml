@model LvtLesson10.Models.LvtMember

@{
    ViewData["Title"] = "Chỉnh sửa Thành viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning bg-gradient text-dark p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Thành viên</h3>
                        <small class="text-dark-50">Cập nhật thông tin chi tiết của thành viên trong hệ thống</small>
                    </div>
                    <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill">
                        ID: #@Model.MemberId
                    </span>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Ẩn MemberId để gửi về server -->
                        <input type="hidden" asp-for="MemberId" />

                        <div class="row g-3">
                            <!-- Mã thành viên (chỉ đọc) -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-secondary">
                                    <i class="bi bi-hash me-1"></i>Mã Thành viên
                                </label>
                                <input value="@Model.MemberId" class="form-control bg-light" disabled readOnly />
                            </div>

                            <!-- Tài khoản -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LvtUserName" class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i>Tài khoản <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-fill"></i></span>
                                    <input asp-for="LvtUserName" class="form-control" placeholder="Nhập tài khoản" required />
                                </div>
                                <span asp-validation-for="LvtUserName" class="text-danger small"></span>
                            </div>

                            <!-- Mật khẩu -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LvtPassword" class="form-label fw-bold">
                                    <i class="bi bi-key me-1"></i>Mật khẩu <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="LvtPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" required />
                                </div>
                                <span asp-validation-for="LvtPassword" class="text-danger small"></span>
                            </div>

                            <!-- Họ và Tên -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LvtFullName" class="form-label fw-bold">
                                    <i class="bi bi-card-heading me-1"></i>Họ và Tên <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-vcard"></i></span>
                                    <input asp-for="LvtFullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" required />
                                </div>
                                <span asp-validation-for="LvtFullName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LvtEmail" class="form-label fw-bold">
                                    <i class="bi bi-envelope me-1"></i>Email <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope-at-fill"></i></span>
                                    <input asp-for="LvtEmail" type="email" class="form-control" placeholder="example@domain.com" required />
                                </div>
                                <span asp-validation-for="LvtEmail" class="text-danger small"></span>
                            </div>

                            <!-- Số điện thoại -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LvtPhone" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i>Số điện thoại
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone-fill"></i></span>
                                    <input asp-for="LvtPhone" class="form-control" placeholder="0901234567" />
                                </div>
                                <span asp-validation-for="LvtPhone" class="text-danger small"></span>
                            </div>

                            <!-- Trạng thái -->
                            <div class="col-12 mb-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="form-check form-switch fs-5">
                                        <input class="form-check-input" type="checkbox" asp-for="LvtStatus" id="lvtStatusSwitch" />
                                        <label class="form-check-label fw-semibold" for="lvtStatusSwitch">
                                            <i class="bi bi-star-fill text-warning me-1"></i> Kích hoạt / Thành viên tích cực (Đạt chỉ tiêu)
                                        </label>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4">Bật tùy chọn này để công nhận thành viên đã hoàn thành thành tích xuất sắc.</small>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Nút điều hướng -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg px-4 text-dark font-weight-bold shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}